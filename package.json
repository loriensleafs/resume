{
  "name": "resume",
  "private": true,
  "type": "module",
  "description": "Peter Kloss's resume: one YAML source, printed to PDF, Word and text, served as a website with an AI chat",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:site": "bun run scripts/build-site.ts",
    "dev": "bun --bun vite dev",
    "documents": "bun run scripts/documents.ts",
    "fonts": "bun run scripts/make-fonts.ts",
    "icons": "bun run scripts/icons.ts",
    "intent": "bun --bun node_modules/@tanstack/intent/dist/cli.mjs",
    "design-system-mcp": "bun --bun node_modules/@acmelabs/design-system-mcp/dist/cli.js",
    "knowledge": "bun run scripts/knowledge.ts",
    "preview": "bun run scripts/preview-site.ts",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@acmelabs/design-system": "0.3.3",
    "@acmelabs/design-system-react": "0.3.3",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-anthropic": "1.0.0",
    "@tanstack/ai-react": "1.0.0",
    "@tanstack/markdown": "0.0.13",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "docx": "9.14.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@acmelabs/design-system-mcp": "0.3.3",
    "@tanstack/intent": "0.5.6",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "harfbuzzjs": "1.6.4",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "intent": {
    "skills": [
      "@acmelabs/design-system",
      "@tanstack/*"
    ]
  }
}
